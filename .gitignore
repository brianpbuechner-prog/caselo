# Student data protection.
# Spreadsheet and delimited exports are blocked everywhere so a real SIS
# export can never be committed. The only exception is the synthetic
# sample data folder below.
*.csv
*.tsv
*.xlsx
*.xls
*.xlsm
*.ods
*.CSV
*.TSV
*.XLSX
*.XLS
*.XLSM
*.ODS
!public/sample-data/
!public/sample-data/*.csv
!public/sample-data/*.tsv
!public/sample-data/*.xlsx
